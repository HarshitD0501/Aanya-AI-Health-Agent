# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM — use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google retires Gemini models without notice — gemini-2.0-flash and
# gemini-2.5-flash both now return 404 NOT_FOUND (while still being listed by the
# models endpoint, so that list proves nothing). Override the default here when
# that happens next; no code change needed. Pick a flash/flash-lite model, not
# pro: this is a live phone call, so first-token latency is what the caller feels.
# GEMINI_MODEL=gemini-3.5-flash-lite

# For OpenAI: get from https://platform.openai.com/api-keys (if using OpenAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Day 6 — Outbound telephony (medication reminder calls)
#
# The agent talks SIP directly through LiveKit, so no Twilio SDK or Account SID
# is needed here. What you need is an Elastic SIP Trunk:
#   1. Twilio Console → Elastic SIP Trunking → Trunks → create a trunk
#   2. Termination tab → set a SIP URI: <name>.pstn.twilio.com
#   3. Termination → Credential Lists → create one (you invent the user/pass)
#   4. Numbers tab → attach your Twilio number to the trunk
#   5. On a trial account, verify the destination mobile under
#      Phone Numbers → Verified Caller IDs (trials can only dial verified numbers)
#   6. Register the trunk with LiveKit, which prints the trunk ID:
#        cp outbound-trunk.example.json outbound-trunk.json   # then fill it in
#        lk sip outbound create outbound-trunk.json
# -----------------------------------------------------------------------------

# The LiveKit SIP trunk ID printed by `lk sip outbound create` (starts with ST_).
SIP_OUTBOUND_TRUNK_ID=ST_xxxxxxxxxxxx

# Caller ID shown on the callee's phone — your Twilio number in E.164.
SIP_FROM_NUMBER=+1XXXXXXXXXX

# Must match the agent_name in agent.py's @server.rtc_session decorator, or the
# dialer will dispatch a job no worker ever picks up.
LIVEKIT_AGENT_NAME=Aanya

# Your own mobile in E.164, used by the test/demo scripts. On a Twilio trial this
# must be a Verified Caller ID.
REMINDER_TEST_NUMBER=+91XXXXXXXXXX

# -----------------------------------------------------------------------------
# Ringing a SIP account (Linphone) instead of a phone number — see
# LINPHONE_SETUP.md
#
# Twilio failed here twice over: on this trunk sip.callStatus never leaves
# 'dialing' even on a call you answered and talked on, and a trial account only
# dials Verified Caller IDs. Linphone's free sip.linphone.org account answers with
# a real 200 OK and accepts a call from anybody, so it is what the demo rings.
#
# Only the *destination* changes. The participant identity stays the reminder's
# phone_number, so the agent, the answer poll and the analytics masking are all
# untouched.
# -----------------------------------------------------------------------------

# Where calls go. 'linphone' (or 'sip') forces the SIP account even for reminder
# rows that still hold a phone number; 'pstn' (or 'twilio') forces the trunk
# above; 'auto' — the default — decides from the shape of the destination.
# SIP_PROVIDER=linphone

# The Linphone username to ring. Required when a phone-number row is routed to
# SIP; the remap is logged as a warning on every call so it is never silent.
# SIP_LINPHONE_USER=your_linphone_username

# Registrar host. Defaults to sip.linphone.org. Add a port for TLS: :5061
# SIP_LINPHONE_DOMAIN=sip.linphone.org

# Either register a stored trunk and paste its ID here...
#   cp linphone-trunk.example.json linphone-trunk.json   # then fill it in
#   lk sip outbound create linphone-trunk.json
# SIP_LINPHONE_TRUNK_ID=ST_xxxxxxxxxxxx

# ...or skip the CLI entirely and let every dial carry an inline trunk built from
# these. sip.linphone.org answers an unauthenticated INVITE with 403, so the
# credential is not optional on this path. Same account as the app.
# SIP_LINPHONE_AUTH_USERNAME=your_linphone_username
# SIP_LINPHONE_AUTH_PASSWORD=your_linphone_password

# udp, tcp, tls, or blank for auto. Only set this if the trunk refuses the
# default transport (see the table in LINPHONE_SETUP.md).
# SIP_LINPHONE_TRANSPORT=

# From user on the INVITE. Defaults to the auth username. SIP_FROM_NUMBER is
# deliberately ignored on the SIP leg — Linphone 403s a From it does not own.
# SIP_LINPHONE_FROM_USER=

# Send 'user@domain' as the dial destination instead of the bare user. Off by
# default because the trunk's own address supplies the domain.
# SIP_CALL_TO_INCLUDES_DOMAIN=false

# allow | require | disable. LiveKit offers unencrypted RTP by default, and a
# Linphone account rejects that with '488 Not acceptable here', so the SIP leg
# defaults to 'allow' — offer SRTP, still accept plain. Only set this if the app
# is configured for mandatory ('require') or no ('disable') encryption.
# SIP_MEDIA_ENCRYPTION=allow

# -----------------------------------------------------------------------------
# Day 7 — Human escalation notifications (OPTIONAL)
#
# Where Aanya posts a "human help needed" card when she escalates. The SQLite
# row and the /help-desk dashboard are the source of truth, so leaving this
# blank is a supported mode (delivery_status becomes 'saved_only') — an
# escalation is never lost because the webhook is missing.
#
# Discord:
#   1. Create/pick a server, then a channel (e.g. #aanya-escalations)
#   2. Channel → Edit Channel (gear) → Integrations → Webhooks
#   3. New Webhook → name it "Aanya Health Desk" → pick the channel
#   4. Copy Webhook URL → paste below. It IS the credential — never commit it.
#
# Slack works too: paste an https://hooks.slack.com/services/... URL instead and
# the payload switches to Slack's format automatically. No code change needed.
# -----------------------------------------------------------------------------
ESCALATION_WEBHOOK_URL=
