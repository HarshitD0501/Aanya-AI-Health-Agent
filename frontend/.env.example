# =============================================================================
# Frontend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport — must match your backend agent's LiveKit project)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Agent dispatch (optional)
# Leave blank for automatic dispatch; set to agent name for explicit dispatch.
# See https://docs.livekit.io/agents/server/agent-dispatch
# -----------------------------------------------------------------------------
AGENT_NAME=

# -----------------------------------------------------------------------------
# Optional — LiveKit Cloud Sandbox / custom app config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
# SANDBOX_ID=

# -----------------------------------------------------------------------------
# Day 7 — /help-desk dashboard (open human-help requests)
#
# The page reads the Python agent's SQLite file read-only, so it can never lock
# or corrupt the writer the voice agent depends on. Leave the path blank to use
# ../backend/health_memory.db, which is correct for this repo layout.
# -----------------------------------------------------------------------------
ESCALATION_DB_PATH=../backend/health_memory.db

# -----------------------------------------------------------------------------
# Day 8 — /analytics dashboard (call performance metrics)
#
# Reads the same SQLite file as ESCALATION_DB_PATH above (both tables live in
# health_memory.db). Set this only if your analytics DB lives elsewhere;
# otherwise the dashboard falls back to ESCALATION_DB_PATH, then to
# ../backend/health_memory.db automatically.
# -----------------------------------------------------------------------------
ANALYTICS_DB_PATH=../backend/health_memory.db

# Rows on this page hold health complaints and phone numbers. With a token set,
# the page only opens at /help-desk?token=<this value>; leave it blank and the
# page is open to anyone who can reach the server (fine on localhost only — the
# page prints a warning banner saying so). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HELPDESK_TOKEN=
